{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm ci:*)", "Bash(npm test:*)", "Bash(npm run:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git switch:*)", "Bash(git checkout:*)", "Bash(git fetch:*)",
      "Bash(git rebase:*)", "Bash(git push:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr diff:*)",
      "Bash(gh pr checkout:*)", "Bash(gh pr comment:*)", "Bash(gh pr checks:*)",
      "Bash(docker compose:*)", "Bash(trivy:*)", "Bash(semgrep:*)", "Bash(orca:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)", "Bash(gh repo delete:*)", "Bash(gh api:*)", "Bash(gh auth:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git push origin main:*)", "Bash(git push origin master:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.config/gh/**)",
      "Edit(.claude/**)", "Edit(AGENTS.md)", "Edit(CLAUDE.md)", "Edit(.github/**)",
      "Edit(~/.bashrc)", "Edit(~/.claude/**)", "Edit(~/.codex/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-only-workers.sh\"" } ] }
    ]
  }
}
