{
  "name": "orca-sdlc-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:e2e": "node --env-file-if-exists=.env --test \"test/e2e/*.test.js\"",
    "lint": "node --check src/app.js && node --check src/store.js && node --check src/server.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
